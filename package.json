{
  "name": "@revaro/design-system",
  "version": "0.6.0",
  "description": "Revaro seller app design system: tokens, rv- component classes, fonts and a Tailwind CSS v4 theme.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "tokens",
    "components/bundle.css",
    "tailwind",
    "assets/Fonts",
    "assets/Icons",
    "assets/Logos"
  ],
  "style": "./components/bundle.css",
  "exports": {
    "./tailwind.css": "./tailwind/revaro.css",
    "./tokens.css": "./tokens/tokens.css",
    "./bundle.css": "./components/bundle.css",
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-site.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
