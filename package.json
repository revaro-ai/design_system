{
  "name": "@revaro/design-system",
  "version": "2.0.0",
  "description": "Revaro React components built on Base UI and Tailwind CSS v4, with semantic light and dark tokens and the Rubik and Pyidaungsu fonts.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "tokens",
    "assets/Fonts",
    "assets/Icons",
    "assets/Logos",
    "src",
    "styles",
    "scripts/build-react-tokens.mjs"
  ],
  "exports": {
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./styles.css": "./styles/tailwind.css",
    "./components/*": "./src/components/*.tsx",
    "./cn": "./src/cn.ts"
  },
  "scripts": {
    "build": "node scripts/build-react-tokens.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@base-ui/react": "^1.9.0",
    "tailwind-merge": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revaro-ai/design_system.git"
  }
}
